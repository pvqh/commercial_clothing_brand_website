# Production web server (research R17). Set SITE_DOMAIN in deploy/.env, for example
# SITE_DOMAIN=example.ru. Caddy obtains and renews the HTTPS certificate automatically.
{
	order rate_limit before reverse_proxy
}

{$SITE_DOMAIN} {
	encode zstd gzip

	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
		X-Content-Type-Options "nosniff"
		-Server
	}

	# Product photos and their renditions: file names never change, so cache them for a year.
	handle_path /media/* {
		root * /srv/media
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# Field performance beacon: an anonymous counter, so keep abuse cheap.
	rate_limit {
		zone rum {
			match {
				path /rum/
			}
			key {remote_host}
			events 30
			window 1m
		}
	}

	reverse_proxy web:8000

	# Access log without full IP addresses or credentials (constitution Principle VI).
	log {
		output stdout
		format filter {
			wrap json
			fields {
				request>remote_ip ip_mask 16 32
				request>client_ip ip_mask 16 32
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}
