# Copy to .env and replace SECRET_KEY with a long random value:
#   uv run python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=change-me
DATABASE_URL=postgres://catalog:catalog@localhost:5432/catalog
DJANGO_SETTINGS_MODULE=config.settings.dev
# If another PostgreSQL already uses port 5432, start Docker with CATALOG_DB_PORT=5433
# and change the port in DATABASE_URL to match.
